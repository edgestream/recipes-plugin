{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "recipes",
  "version": "0.1.1",
  "description": "Cooking recipes",
  "author": {
    "name": "Edgestream"
  },
  "keywords": [
    "recipes",
    "cooking",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Recipes",
        "shortDescription": "Cooking recipes",
        "longDescription": "Search and retrieve cooking recipes from your own collection and external sources.",
        "developerName": "Edgestream",
        "category": "Lifestyle",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "List my recipes",
          "Search recipes for spaghetti",
          "Show the details of the first recipe from those search results",
          "Import that recipe into my collection"
        ],
        "brandColor": "#F97316"
      }
    }
  }
}
